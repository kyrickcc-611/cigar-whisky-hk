# ---------------------------------------------------------------------------
# Firebase Web App 設定
# 位置：Firebase Console → 專案設定 (⚙️) → 你的應用程式 → Web App → SDK 設定和配置
# 貼上後請重新啟動 `npm run dev`（環境變數只在啟動時讀取）
# 注意：這些值會被打包到前端，屬公開資訊；請勿在此放入 service account 私鑰。
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Google Maps JavaScript API（地圖模式、地點搜尋用）
# 位置：Google Cloud Console → APIs & Services → Credentials
# 建議限制：Application restrictions = HTTP referrers（localhost + 你的 Vercel 網域）
#          API restrictions = Maps JavaScript API（如用 Places 亦要加入）
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
